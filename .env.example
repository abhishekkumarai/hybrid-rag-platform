# Tesseract binary path (only needed for legacy OCR scratch utilities)
TESSERACT_CMD=

# PostgreSQL - used by Langflow for flow and chat history persistence.
# Under docker compose the app services override POSTGRES_HOST to the `postgres` service name;
# these values seed the container and must match what Langflow connects with.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Hardware profile: `quality` (llama3.1:8b) or `fast` (llama3.2:3b)
RAG_PROFILE=quality

# Where the app services reach Ollama. Left unset locally it defaults to 127.0.0.1:11434;
# docker compose points it at the host, or at the `ollama` container under the local-llm profile.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Langflow admin credentials (local development defaults)
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=admin

# Host port for the containerised PostgreSQL. Defaults to 5433 to avoid colliding with a
# PostgreSQL already running on the host at 5432.
POSTGRES_HOST_PORT=5433

# Host port for the containerised Gateway & UI. Defaults to 8001 if 8000 is occupied.
GATEWAY_HOST_PORT=8001
